# Copy to apps/api/.env for local development (never commit .env)
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
SWAGGER_ENABLED=true
LOG_LEVEL=debug
DATABASE_URL=mysql://app:apppass@localhost:3306/persian_ecommerce
# Separate database for integration tests (created automatically if the user has rights)
TEST_DATABASE_URL=mysql://root:rootpass@localhost:3306/persian_ecommerce_test
