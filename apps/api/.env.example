# Copy to apps/api/.env for local development (never commit .env)
NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
SWAGGER_ENABLED=true
LOG_LEVEL=debug
DATABASE_URL=mysql://app:apppass@localhost:3306/persian_ecommerce
# Separate database for integration tests (created automatically if the user has rights)
TEST_DATABASE_URL=mysql://root:rootpass@localhost:3306/persian_ecommerce_test
# --- authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=unit-test-secret-that-is-long-enough-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# COOKIE_SECURE defaults to true in production
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=30
VERIFICATION_CODE_TTL_MINUTES=10
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
