// Persian E-Commerce — Prisma schema (MariaDB)
//
// Conventions
// - Primary keys are time-ordered UUID v7 strings (index friendly, unguessable).
// - Money is stored as BIGINT integers in Iranian Rial (IRR). Never floats.
// - Table names are snake_case plural via @@map; columns keep camelCase.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Users, roles and permissions (relational RBAC)
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  DELETED
}

model User {
  id               String     @id @default(uuid(7)) @db.Char(36)
  email            String?    @unique @db.VarChar(255)
  phone            String?    @unique @db.VarChar(20)
  passwordHash     String     @db.VarChar(255)
  firstName        String?    @db.VarChar(100)
  lastName         String?    @db.VarChar(100)
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles               UserRole[]
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  verificationCodes   VerificationCode[]
  addresses           Address[]
  auditLogs           AuditLog[]
  carts               Cart[]
  orders              Order[]
  reviews             Review[]
  moderatedReviews    Review[]       @relation("ReviewModerator")
  wishlistItems       WishlistItem[]
  seller              Seller?

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Char(36)
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid(7)) @db.Char(36)
  key         String   @unique @db.VarChar(100)
  group       String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Char(36)
  roleId     String   @db.Char(36)
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @db.Char(36)
  permissionId String @db.Char(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// Authentication: refresh sessions, password reset, verification codes
// ---------------------------------------------------------------------------

model RefreshSession {
  id         String    @id @default(uuid(7)) @db.Char(36)
  userId     String    @db.Char(36)
  /// SHA-256 hash of the opaque refresh token; the raw token is never stored.
  tokenHash  String    @unique @db.Char(64)
  /// Groups rotated tokens so reuse of an old token revokes the whole chain.
  familyId   String    @db.Char(36)
  userAgent  String?   @db.VarChar(255)
  ipAddress  String?   @db.VarChar(45)
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid(7)) @db.Char(36)
  userId    String    @db.Char(36)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

model VerificationCode {
  id         String              @id @default(uuid(7)) @db.Char(36)
  userId     String              @db.Char(36)
  channel    VerificationChannel
  target     String              @db.VarChar(255)
  codeHash   String              @db.Char(64)
  attempts   Int                 @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
  @@map("verification_codes")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

model Address {
  id             String   @id @default(uuid(7)) @db.Char(36)
  userId         String   @db.Char(36)
  title          String   @db.VarChar(100)
  recipientName  String   @db.VarChar(150)
  recipientPhone String   @db.VarChar(20)
  province       String   @db.VarChar(100)
  city           String   @db.VarChar(100)
  addressLine    String   @db.VarChar(500)
  postalCode     String   @db.Char(10)
  latitude       Decimal? @db.Decimal(9, 6)
  longitude      Decimal? @db.Decimal(9, 6)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Audit log for sensitive administrative actions
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Char(36)
  actorId    String?  @db.Char(36)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(64)
  metadata   Json?
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Catalog: brands, categories, attributes
// ---------------------------------------------------------------------------

model Brand {
  id             String   @id @default(uuid(7)) @db.Char(36)
  name           String   @unique @db.VarChar(150)
  nameEn         String?  @db.VarChar(150)
  slug           String   @unique @db.VarChar(180)
  description    String?  @db.Text
  logoUrl        String?  @db.VarChar(500)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?  @db.VarChar(255)
  seoDescription String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@map("brands")
}

model Category {
  id             String   @id @default(uuid(7)) @db.Char(36)
  parentId       String?  @db.Char(36)
  name           String   @db.VarChar(150)
  slug           String   @unique @db.VarChar(180)
  description    String?  @db.Text
  imageUrl       String?  @db.VarChar(500)
  /// Materialised path of ancestor ids ("/id1/id2/") for subtree queries.
  path           String   @db.VarChar(1200)
  depth          Int      @default(0)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  seoTitle       String?  @db.VarChar(255)
  seoDescription String?  @db.VarChar(500)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[]          @relation("CategoryTree")
  products   Product[]
  attributes CategoryAttribute[]

  @@index([parentId])
  @@index([isActive])
  @@index([path(length: 191)])
  @@map("categories")
}

enum AttributeType {
  SELECT
  TEXT
  NUMBER
  BOOLEAN
}

model Attribute {
  id           String        @id @default(uuid(7)) @db.Char(36)
  name         String        @db.VarChar(150)
  slug         String        @unique @db.VarChar(100)
  type         AttributeType @default(SELECT)
  unit         String?       @db.VarChar(30)
  /// Variant-defining attributes (e.g. colour, storage) create SKUs.
  isVariant    Boolean       @default(false)
  isFilterable Boolean       @default(true)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  values     AttributeValue[]
  categories CategoryAttribute[]
  products   ProductAttributeValue[]
  variants   VariantAttributeValue[]

  @@map("attributes")
}

model AttributeValue {
  id          String   @id @default(uuid(7)) @db.Char(36)
  attributeId String   @db.Char(36)
  value       String   @db.VarChar(150)
  slug        String   @db.VarChar(150)
  colorHex    String?  @db.Char(7)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  attribute Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  products  ProductAttributeValue[]
  variants  VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@map("attribute_values")
}

model CategoryAttribute {
  categoryId  String  @db.Char(36)
  attributeId String  @db.Char(36)
  isRequired  Boolean @default(false)
  sortOrder   Int     @default(0)

  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

// ---------------------------------------------------------------------------
// Products and variants
// ---------------------------------------------------------------------------

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
}

model Product {
  id               String        @id @default(uuid(7)) @db.Char(36)
  title            String        @db.VarChar(255)
  titleEn          String?       @db.VarChar(255)
  slug             String        @unique @db.VarChar(180)
  categoryId       String        @db.Char(36)
  brandId          String?       @db.Char(36)
  description      String?       @db.Text
  shortDescription String?       @db.VarChar(500)
  status           ProductStatus @default(DRAFT)
  /// Denormalised from active variants for listing/filtering (IRR).
  minPrice         BigInt?
  maxPrice         BigInt?
  ratingAverage    Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount      Int           @default(0)
  weightGrams      Int?
  seoTitle         String?       @db.VarChar(255)
  seoDescription   String?       @db.VarChar(500)
  /// Normalised text (title, English title, brand, category, SKUs, short description) for FULLTEXT search.
  searchText       String?       @db.Text
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category       Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand          Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  variants       ProductVariant[]
  attributes     ProductAttributeValue[]
  specifications ProductSpecification[]
  reviews        Review[]
  wishlistItems  WishlistItem[]

  @@index([status])
  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([minPrice])
  @@index([createdAt])
  @@index([publishedAt])
  @@fulltext([searchText])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7)) @db.Char(36)
  productId String   @db.Char(36)
  variantId String?  @db.Char(36)
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(255)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

/// Informational (non-variant) attribute values of a product.
model ProductAttributeValue {
  productId   String  @db.Char(36)
  attributeId String  @db.Char(36)
  valueId     String? @db.Char(36)
  valueText   String? @db.VarChar(255)

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue? @relation(fields: [valueId], references: [id], onDelete: SetNull)

  @@id([productId, attributeId])
  @@index([attributeId, valueId])
  @@map("product_attribute_values")
}

/// Free-form specification rows shown on the product page.
model ProductSpecification {
  id        String  @id @default(uuid(7)) @db.Char(36)
  productId String  @db.Char(36)
  group     String? @db.VarChar(100)
  name      String  @db.VarChar(150)
  value     String  @db.VarChar(500)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model ProductVariant {
  id             String        @id @default(uuid(7)) @db.Char(36)
  productId      String        @db.Char(36)
  sku            String        @unique @db.VarChar(64)
  barcode        String?       @unique @db.VarChar(64)
  title          String?       @db.VarChar(255)
  /// Unit price in IRR.
  price          BigInt
  /// Optional "was" price in IRR; must exceed `price` when set.
  compareAtPrice BigInt?
  status         VariantStatus @default(ACTIVE)
  isDefault      Boolean       @default(false)
  weightGrams    Int?
  sortOrder      Int           @default(0)
  /// Marketplace seller offering this variant; null for platform-owned stock.
  sellerId       String?       @db.Char(36)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  product               Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller                Seller?                 @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  attributeValues       VariantAttributeValue[]
  images                ProductImage[]
  inventory             Inventory?
  inventoryTransactions InventoryTransaction[]
  cartItems             CartItem[]
  orderItems            OrderItem[]

  @@index([productId, status])
  @@index([sellerId, status])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId   String @db.Char(36)
  attributeId String @db.Char(36)
  valueId     String @db.Char(36)

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute Attribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value     AttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeId])
  @@index([valueId])
  @@map("variant_attribute_values")
}

// ---------------------------------------------------------------------------
// Inventory (available = stock - reserved)
// ---------------------------------------------------------------------------

enum InventoryTransactionType {
  PURCHASE
  RESERVATION
  RELEASE
  SALE
  RETURN
  ADJUSTMENT
}

model Inventory {
  variantId         String   @id @db.Char(36)
  stockQuantity     Int      @default(0)
  reservedQuantity  Int      @default(0)
  lowStockThreshold Int      @default(5)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([stockQuantity])
  @@map("inventory")
}

/// Immutable ledger of every inventory change.
model InventoryTransaction {
  id            String                   @id @default(uuid(7)) @db.Char(36)
  variantId     String                   @db.Char(36)
  type          InventoryTransactionType
  /// Signed change applied to stock (or to reserved for RESERVATION/RELEASE).
  quantity      Int
  stockAfter    Int
  reservedAfter Int
  referenceType String?                  @db.VarChar(50)
  referenceId   String?                  @db.VarChar(64)
  note          String?                  @db.VarChar(255)
  actorId       String?                  @db.Char(36)
  createdAt     DateTime                 @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

// ---------------------------------------------------------------------------
// Cart, coupons, shipping
// ---------------------------------------------------------------------------

enum CartStatus {
  ACTIVE
  MERGED
  CONVERTED
  ABANDONED
}

model Cart {
  id          String     @id @default(uuid(7)) @db.Char(36)
  userId      String?    @db.Char(36)
  /// SHA-256 hash of the guest cart cookie token.
  sessionHash String?    @unique @db.Char(64)
  status      CartStatus @default(ACTIVE)
  couponCode  String?    @db.VarChar(50)
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@index([status, updatedAt])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid(7)) @db.Char(36)
  cartId     String   @db.Char(36)
  variantId  String   @db.Char(36)
  quantity   Int
  /// Unit price (IRR) when the item was added; used to flag price changes.
  priceAtAdd BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

model ShippingMethod {
  id               String   @id @default(uuid(7)) @db.Char(36)
  code             String   @unique @db.VarChar(50)
  name             String   @db.VarChar(150)
  description      String?  @db.VarChar(500)
  /// Flat fee in IRR.
  baseFee          BigInt
  /// Orders with a subtotal at or above this amount (IRR) ship free.
  freeAboveAmount  BigInt?
  estimatedDaysMin Int      @default(1)
  estimatedDaysMax Int      @default(3)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("shipping_methods")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id                String       @id @default(uuid(7)) @db.Char(36)
  code              String       @unique @db.VarChar(50)
  description       String?      @db.VarChar(255)
  type              DiscountType
  /// Percentage (0-100) for PERCENTAGE, amount in IRR for FIXED.
  value             Int
  maxDiscountAmount BigInt?
  minCartAmount     BigInt?
  startsAt          DateTime?
  endsAt            DateTime?
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int          @default(0)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders Order[]

  @@index([isActive])
  @@map("coupons")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id                 String      @id @default(uuid(7)) @db.Char(36)
  /// Sequential human-readable number (rendered as e.g. PE-100042).
  number             Int         @unique @default(autoincrement())
  userId             String      @db.Char(36)
  status             OrderStatus @default(PENDING_PAYMENT)
  currency           String      @default("IRR") @db.Char(3)
  /// Sum of line totals at order time (IRR).
  subtotal           BigInt
  /// Coupon discount (IRR).
  discount           BigInt      @default(0)
  shippingFee        BigInt      @default(0)
  /// Amount the customer pays: subtotal - discount + shippingFee.
  total              BigInt
  couponId           String?     @db.Char(36)
  couponCode         String?     @db.VarChar(50)
  // Shipping snapshot
  shippingMethodCode String      @db.VarChar(50)
  shippingMethodName String      @db.VarChar(150)
  estimatedDaysMin   Int         @default(1)
  estimatedDaysMax   Int         @default(3)
  recipientName      String      @db.VarChar(150)
  recipientPhone     String      @db.VarChar(20)
  province           String      @db.VarChar(100)
  city               String      @db.VarChar(100)
  addressLine        String      @db.VarChar(500)
  postalCode         String      @db.Char(10)
  customerNote       String?     @db.VarChar(500)
  /// Unpaid orders past this time are cancelled and their reservations released.
  paymentDeadlineAt  DateTime
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancelReason       String?     @db.VarChar(255)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon        Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  shipments     Shipment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, paymentDeadlineAt])
  @@index([createdAt])
  @@map("orders")
}

/// Immutable snapshot of a purchased line; never reads current product data.
model OrderItem {
  id             String  @id @default(uuid(7)) @db.Char(36)
  orderId        String  @db.Char(36)
  variantId      String? @db.Char(36)
  productId      String? @db.Char(36)
  productTitle   String  @db.VarChar(255)
  productSlug    String  @db.VarChar(180)
  variantTitle   String? @db.VarChar(255)
  sku            String  @db.VarChar(64)
  imageUrl       String? @db.VarChar(500)
  unitPrice      BigInt
  compareAtPrice BigInt?
  quantity       Int
  lineTotal      BigInt
  /// Marketplace snapshot: seller at order time, platform commission and the seller's share (IRR).
  sellerId         String?  @db.Char(36)
  commissionAmount BigInt   @default(0)
  sellerAmount     BigInt   @default(0)
  settlementId     String?  @db.Char(36)

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  seller     Seller?         @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  settlement Settlement?     @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([variantId])
  @@index([sellerId, settlementId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid(7)) @db.Char(36)
  orderId    String       @db.Char(36)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.VarChar(500)
  actorId    String?      @db.Char(36)
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Shipment {
  id           String    @id @default(uuid(7)) @db.Char(36)
  orderId      String    @db.Char(36)
  /// Seller who dispatched it; null for platform shipments.
  sellerId     String?   @db.Char(36)
  carrier      String?   @db.VarChar(100)
  trackingCode String?   @db.VarChar(100)
  shippedAt    DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller   Seller?            @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  tracking ShipmentTracking[]

  @@index([orderId])
  @@index([sellerId])
  @@map("shipments")
}

model ShipmentTracking {
  id          String   @id @default(uuid(7)) @db.Char(36)
  shipmentId  String   @db.Char(36)
  status      String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  occurredAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, occurredAt])
  @@map("shipment_tracking")
}

// ---------------------------------------------------------------------------
// Payments (provider-agnostic; one order may have many attempts)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  ZARINPAL
  SNAPP_PAY
  DIGIPAY
  TOROB_PAY
  MOCK
}

enum PaymentEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentStatus {
  INITIATED
  REDIRECTED
  CALLBACK_RECEIVED
  VERIFYING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Payment {
  id                    String             @id @default(uuid(7)) @db.Char(36)
  orderId               String             @db.Char(36)
  userId                String             @db.Char(36)
  provider              PaymentProvider
  environment           PaymentEnvironment
  attemptNumber         Int
  amount                BigInt
  currency              String             @default("IRR") @db.Char(3)
  status                PaymentStatus      @default(INITIATED)
  /// Idempotency key generated per attempt and sent to the provider where supported.
  requestId             String             @unique @db.Char(36)
  /// Provider token / authority / ticket used to redirect and verify.
  providerAuthority     String?            @db.VarChar(255)
  /// Provider reference / transaction id returned after successful verification.
  providerTransactionId String?            @db.VarChar(255)
  redirectUrl           String?            @db.VarChar(1000)
  cardPanMask           String?            @db.VarChar(32)
  errorCode             String?            @db.VarChar(64)
  errorMessage          String?            @db.VarChar(500)
  callbackPayload       Json?
  verificationPayload   Json?
  redirectedAt          DateTime?
  callbackAt            DateTime?
  verifiedAt            DateTime?
  expiresAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  transactions PaymentTransaction[]

  @@unique([orderId, attemptNumber])
  @@index([provider, providerAuthority])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
  REVERSE
  SETTLEMENT
  INQUIRY
}

/// Immutable ledger of provider interactions per payment attempt.
model PaymentTransaction {
  id                String                 @id @default(uuid(7)) @db.Char(36)
  paymentId         String                 @db.Char(36)
  type              PaymentTransactionType
  amount            BigInt
  succeeded         Boolean
  providerReference String?                @db.VarChar(255)
  errorCode         String?                @db.VarChar(64)
  payload           Json?
  createdAt         DateTime               @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_transactions")
}

/// Database-backed provider registry managed from the admin panel.
model PaymentProviderConfig {
  id                   String             @id @default(uuid(7)) @db.Char(36)
  provider             PaymentProvider    @unique
  displayName          String             @db.VarChar(100)
  enabled              Boolean            @default(false)
  isDefault            Boolean            @default(false)
  environment          PaymentEnvironment @default(SANDBOX)
  /// AES-256-GCM encrypted JSON of provider credentials (key from PAYMENT_ENCRYPTION_KEY).
  credentialsEncrypted String?            @db.Text
  /// Non-secret provider settings (e.g. callback path, currency).
  configuration        Json?
  lastTestedAt         DateTime?
  lastTestSucceeded    Boolean?
  lastTestMessage      String?            @db.VarChar(500)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("payment_provider_configs")
}

// ---------------------------------------------------------------------------
// Reviews & wishlist
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One review per customer per product; ratings on products are aggregated from APPROVED rows only.
model Review {
  id                 String       @id @default(uuid(7)) @db.Char(36)
  productId          String       @db.Char(36)
  userId             String       @db.Char(36)
  rating             Int          @db.TinyInt
  title              String       @db.VarChar(120)
  body               String       @db.Text
  status             ReviewStatus @default(PENDING)
  /// True when the author had a paid order containing the product at submission time.
  isVerifiedPurchase Boolean      @default(false)
  moderationNote     String?      @db.VarChar(500)
  moderatedById      String?      @db.Char(36)
  moderatedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy User?   @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

model WishlistItem {
  userId    String   @db.Char(36)
  productId String   @db.Char(36)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

// ---------------------------------------------------------------------------
// Marketplace: sellers, offers (variants with sellerId) and settlements
// ---------------------------------------------------------------------------

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model Seller {
  id              String       @id @default(uuid(7)) @db.Char(36)
  userId          String       @unique @db.Char(36)
  storeName       String       @unique @db.VarChar(150)
  slug            String       @unique @db.VarChar(180)
  description     String?      @db.VarChar(1000)
  status          SellerStatus @default(PENDING)
  /// Platform commission in basis points (1000 = 10%).
  commissionBps   Int          @default(1000)
  contactPhone    String       @db.VarChar(20)
  contactEmail    String?      @db.VarChar(255)
  legalName       String?      @db.VarChar(255)
  nationalId      String?      @db.VarChar(20)
  /// Payout IBAN; masked in API responses.
  iban            String?      @db.VarChar(34)
  province        String?      @db.VarChar(100)
  city            String?      @db.VarChar(100)
  addressLine     String?      @db.VarChar(500)
  rejectionReason String?      @db.VarChar(500)
  approvedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  orderItems  OrderItem[]
  shipments   Shipment[]
  settlements Settlement[]

  @@index([status])
  @@map("sellers")
}

enum SettlementStatus {
  PENDING
  PAID
  CANCELLED
}

/// Payout batch for a seller: delivered order items not yet settled.
model Settlement {
  id               String           @id @default(uuid(7)) @db.Char(36)
  sellerId         String           @db.Char(36)
  status           SettlementStatus @default(PENDING)
  grossAmount      BigInt
  commissionAmount BigInt
  netAmount        BigInt
  itemCount        Int
  periodStart      DateTime?
  periodEnd        DateTime?
  note             String?          @db.VarChar(500)
  paymentReference String?          @db.VarChar(100)
  paidAt           DateTime?
  createdById      String?          @db.Char(36)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  seller Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items  OrderItem[]

  @@index([sellerId, status])
  @@map("settlements")
}
