# ---------------------------------------------------------------------------
# Persian E-Commerce — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
NODE_ENV=development
# Public origin of the site (used for cookies, CORS, callbacks and SEO URLs)
APP_URL=http://localhost:8080

# --- MariaDB ---------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=persian_ecommerce
MARIADB_USER=app
MARIADB_PASSWORD=change-me-app
# Port exposed on the host in development only (production compose does not publish it)
MARIADB_PORT=3306

# Connection string used by the API (inside docker the host is `mariadb`)
DATABASE_URL=mysql://app:change-me-app@localhost:3306/persian_ecommerce

# --- API (NestJS) ----------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Set to "true" to expose Swagger UI at /api/docs. Keep it "false" in production.
SWAGGER_ENABLED=false
LOG_LEVEL=info

# --- Web (Next.js) ---------------------------------------------------------
WEB_PORT=3000
# URL the browser uses to call the API (same origin through nginx in production)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# URL the Next.js server uses to call the API (inside docker: http://api:4000/api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1

# --- Nginx -----------------------------------------------------------------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Orders & payments -----------------------------------------------------
# Minutes an unpaid order keeps its stock reservation before expiring.
ORDER_PAYMENT_TIMEOUT_MINUTES=30
# Public base URL of the API as reachable by payment gateways for callbacks.
# Defaults to ${APP_URL}/api/v1.
API_PUBLIC_URL=
# AES-256-GCM key (>= 32 chars) that encrypts gateway credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PAYMENT_ENCRYPTION_KEY=
# Enables the "mock" gateway for local testing. Refused when the API runs with
# NODE_ENV=production, so set API_NODE_ENV=development for a local Compose stack
# that should pay through the mock gateway. Never change API_NODE_ENV on a real
# deployment.
API_NODE_ENV=production
PAYMENT_MOCK_ENABLED=false
# Makes the mock gateway the default at checkout on first boot (dev only).
PAYMENT_MOCK_DEFAULT=false

# --- Marketplace ----------------------------------------------------------
# Platform commission for new sellers in basis points (1000 = 10%).
MARKETPLACE_DEFAULT_COMMISSION_BPS=1000

# --- Bootstrap admin (first start only; change after login) ----------------
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
