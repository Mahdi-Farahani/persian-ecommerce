# ---------------------------------------------------------------------------
# Persian E-Commerce — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
NODE_ENV=development
# Public origin of the site (used for cookies, CORS, callbacks and SEO URLs)
APP_URL=http://localhost:8080

# --- MariaDB ---------------------------------------------------------------
MARIADB_ROOT_PASSWORD=change-me-root
MARIADB_DATABASE=persian_ecommerce
MARIADB_USER=app
MARIADB_PASSWORD=admin
# Port exposed on the host in development only (production compose does not publish it)
MARIADB_PORT=3306

# Connection string used by the API (inside docker the host is `mariadb`)
DATABASE_URL=mysql://app:admin@localhost:3306/persian_ecommerce

# --- API (NestJS) ----------------------------------------------------------
API_PORT=4000
API_GLOBAL_PREFIX=api/v1
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Set to "true" to expose Swagger UI at /api/docs (default: enabled outside production)
SWAGGER_ENABLED=true
LOG_LEVEL=info

# --- Web (Next.js) ---------------------------------------------------------
WEB_PORT=3000
# URL the browser uses to call the API (same origin through nginx in production)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
# URL the Next.js server uses to call the API (inside docker: http://api:4000/api/v1)
API_INTERNAL_URL=http://localhost:4000/api/v1

# --- Nginx -----------------------------------------------------------------
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# --- Authentication --------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Bootstrap admin (first start only; change after login) ----------------
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
